# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this website is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Also used as the base for Bachs Checkout success/cancel redirects.
APP_URL="https://www.iamshedstar.com"

# --- Bachs payment gateway ---
# Use sk_sandbox_... for local testing or sk_live_... in production.
# Keep BACHS_API_KEY server-only. Never use a NEXT_PUBLIC_ or VITE_ prefix.
BACHS_API_KEY="sk_sandbox_your_secret_key_here"

# Webhook signing secret from Bachs. Configure the endpoint as
# https://www.iamshedstar.com/api/bachs/webhook.
BACHS_WEBHOOK_SECRET="your_bachs_webhook_secret_here"

# Optional: inferred from the key prefix when omitted.
BACHS_API_BASE_URL="https://sandbox-api.bachs.io"

# Settlement currency for all charges (ISO 4217, lowercase). Prices are in USD.
CURRENCY="usd"
